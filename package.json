{
  "name": "image-annotator",
  "version": "0.0.1",
  "description": "Manual morphometry of H&E-stained blood-vessel sections (media-lumen ratio, wall thickness, variability)",
  "productName": "Image Annotator",
  "author": "Valentin Schröter <valentin.schroeter@student.hpi.uni-potsdam.de>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vschroeter/image-annotator.git"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev -m electron",
    "build": "quasar build -m electron",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "2d-geometry": "^3.0.0",
    "@quasar/extras": "^1.17.0",
    "@vueuse/core": "^12.8.2",
    "konva": "^9.3.22",
    "mitt": "^3.0.1",
    "pinia": "^2.3.1",
    "quasar": "^2.18.2",
    "sharp": "^0.33.5",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@quasar/app-vite": "^2.3.0",
    "@types/node": "^20.19.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "~5.5.4",
    "vite-plugin-checker": "^0.8.0",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "pnpm": ">=10"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "^0.33.5"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp",
      "@img/sharp-win32-x64",
      "vue-demi"
    ]
  }
